#!/usr/bin/env bash
# tx — tmux + Claude Code session controller.
#
# Usage:
#   tx start [-r|--restart]    Ensure the Views home-base session exists, warm the
#                              tx-assistant, and attach Views. --restart kills an
#                              existing tx-assistant first.
#   tx attach                  Open the session picker.
#   tx ls                      Plain stdout list: VIEWS and PROCESSES sections.
#   tx spawn <name> --tag TAGS [--cwd DIR] [--cmd "CMD"]
#                              Spawn a detached tmux session. --tag is mandatory (no inheritance).
#   tx spawn-nvim <name> --tag TAGS [--cwd DIR] [--diff [BASE]]
#                              Spawn a detached nvim companion. --diff defaults BASE to main.
#   tx spawn-view <name> [--tag TAGS] [--cwd DIR] [--cmd "CMD"]
#                              Spawn a detached view session (@kind=view). --tag defaults to "views".
#   tx mailbox                 Open the mailbox TUI (live + archived inbox).
#   tx help                    Show this message (also what `tx` shows with no args).
#
# Picker flags (apply to `tx attach`):
#   -f QUERY                   Pre-fill the search with QUERY.
#   --host [ALIAS]             Pick from remote tmux on ssh ALIAS (default: personal).
#   --all                      Pick from local + personal, remote rows prefixed (r).
#   --jump / -j                Enter focuses the existing pane hosting the session
#                              instead of nest-attaching here (popup-friendly).
#
# Flags must precede the subcommand.
set -u

# palette.sh lives at <repo>/shared/palette.sh — one level up from this file.
# readlink resolves the ~/.local/bin install symlink back to the repo.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../shared/palette.sh"

B=$'\e[1m'
R=$'\e[0m'
NAMEW=${NAMEW:-18}
HOST=""
MIX=0
MIX_REMOTE_ALIAS="personal"
JUMP_MODE=0

reltime() {
  local then="$1" now="${2:-}" d
  [[ -z "$then" || "$then" == 0 ]] && {
    echo "-"
    return
  }
  [[ -z "$now" ]] && now=$(date +%s)
  d=$((now - then))
  ((d < 0)) && d=0
  if ((d < 60)); then
    printf '%ds\n' "$d"
  elif ((d < 3600)); then
    printf '%dm\n' $((d / 60))
  elif ((d < 86400)); then
    printf '%dh\n' $((d / 3600))
  else
    printf '%dd\n' $((d / 86400))
  fi
}

trunc() {
  local s="$1" w="$2"
  if ((${#s} > w)); then printf '%s…' "${s:0:w-1}"; else printf '%s' "$s"; fi
}

# True if the named session has @kind set to "view".
is_view_session() {
  [[ "$(tmux show-options -vt "$1" -q @kind 2>/dev/null)" == "view" ]]
}

# Column width of the surrounding terminal/popup. Inside a tmux popup,
# /dev/tty is the popup's pty so this returns the popup width.
detect_term_cols() {
  local cols
  if cols=$(stty size 2>/dev/null </dev/tty); then
    cols="${cols##* }"
    [[ "$cols" =~ ^[0-9]+$ ]] && {
      printf '%s' "$cols"
      return
    }
  fi
  if cols=$(tput cols 2>/dev/null); then
    [[ "$cols" =~ ^[0-9]+$ ]] && {
      printf '%s' "$cols"
      return
    }
  fi
  printf '%s' "${COLUMNS:-80}"
}

# Longest visible session name, including the "(r) " prefix on remote rows.
measure_max_name() {
  list_raw | awk -F'|' '$7 != "view" {
      n = length($3); if ($1 == "R") n += 4
      if (n > m) m = n
    } END { print m+0 }'
}

# NAME column width: fit the widest name, capped so STARTED, IDLE, and tag
# chips still fit. Floor 12, ceiling 60.
compute_namew() {
  local cols="$1" longest="${2:-12}"
  # Past NAME: 3 gap + 7 STARTED + 1 + 6 IDLE + ~14 tag reservation + ~2 fzf gutter.
  local overhead=33
  local max=$((cols - overhead))
  ((max < 12)) && max=12
  ((max > 60)) && max=60
  local namew=$longest
  ((namew < 12)) && namew=12
  ((namew > max)) && namew=$max
  printf '%s' "$namew"
}

list_raw() {
  # Each line is `origin|activity|name|attached|created|tag|kind` where origin
  # is `L` (local tmux) or `R` (remote ssh).
  local fmt='#{session_activity}|#{session_name}|#{session_attached}|#{session_created}|#{@tag}|#{@kind}'
  if ((MIX)); then
    tmux list-sessions -F "L|$fmt" 2>/dev/null
    ssh "$MIX_REMOTE_ALIAS" "/opt/homebrew/bin/tmux list-sessions -F 'R|$fmt'" 2>/dev/null
  elif [[ -n "$HOST" ]]; then
    ssh "$HOST" "/opt/homebrew/bin/tmux list-sessions -F 'R|$fmt'" 2>/dev/null
  else
    tmux list-sessions -F "L|$fmt" 2>/dev/null
  fi
}

# Emit fzf rows. Each row is tab-separated:
#   $1 name   $2 plain_chips   $3 origin (L|R)   $4+ visual columns
# Sorted by most recent activity; @kind == view sessions filtered out.
sessions_with_meta() {
  local now
  now=$(date +%s)

  while IFS='|' read -r name created activity tag origin; do
    local prefix=""
    [[ "$origin" == "R" ]] && prefix="(r) "
    name_disp=$(trunc "$name" "$((NAMEW - ${#prefix}))")
    pad=$((NAMEW - ${#name_disp} - ${#prefix}))
    ((pad < 0)) && pad=0
    local plain_chips=""
    if [[ -n "$tag" ]]; then
      local tag_part
      IFS=',' read -ra tag_parts <<<"$tag"
      for tag_part in "${tag_parts[@]}"; do
        plain_chips+=" [${tag_part}]"
      done
    fi
    # NAME/STARTED/TAGS have no ANSI fg — they inherit fzf's fg (DIM_FG) for
    # unselected rows and fg+ (BG_DEEP on ACCENT) when selected. IDLE keeps
    # its WARN escape so the staleness signal stays yellow in both states
    # (matches mx's age column behavior, just rendered on a different bg).
    printf '%s\t%s\t%s\t%s%s%*s   %-7s %b%-6s%b%s\n' \
      "$name" \
      "$plain_chips" \
      "$origin" \
      "$prefix" "$name_disp" "$pad" "" \
      "$(reltime "$created" "$now")" \
      "$WARN_ANSI" "$(reltime "$activity" "$now")" "$R" \
      "$plain_chips"
  done < <(list_raw |
    awk -F'|' '$7 != "view"' |
    sort -t'|' -k2 -nr |
    awk -F'|' 'BEGIN{OFS="|"}{print $3,$5,$2,$6,$1}')
}

cmd_list() {
  sessions_with_meta
}

# tx ls — print sessions in two sections, VIEWS (@kind == view) and PROCESSES
# (everything else). Plain stdout: no fzf, no ANSI, pipe-friendly. Columns are
# name, idle (via reltime), and tag chips.
cmd_ls() {
  local now views_out="" processes_out=""
  now=$(date +%s)
  while IFS='|' read -r origin activity name attached created tag kind; do
    local idle chips="" tag_part
    idle=$(reltime "$activity" "$now")
    if [[ -n "$tag" ]]; then
      local -a tag_parts
      IFS=',' read -ra tag_parts <<<"$tag"
      for tag_part in "${tag_parts[@]}"; do
        chips+=" [${tag_part}]"
      done
    fi
    local row
    row=$(printf '  %-24s %-6s%s' "$name" "$idle" "$chips")
    if [[ "$kind" == "view" ]]; then
      views_out+="$row"$'\n'
    else
      processes_out+="$row"$'\n'
    fi
  done < <(list_raw | sort -t'|' -k2 -nr)

  printf 'VIEWS\n'
  [[ -n "$views_out" ]] && printf '%s' "$views_out"
  printf '\nPROCESSES\n'
  [[ -n "$processes_out" ]] && printf '%s' "$processes_out"
}


# Hidden subcommand — invoked from the fzf binding via tmux display-popup.
# Prompts (with the current value pre-filled via Python's readline since macOS
# bash 3.2 lacks `read -i`) and writes back via `tmux set`. Empty input unsets.
# Cancel (Ctrl-C / Ctrl-D) leaves the existing tag untouched.
cmd_edit_tag() {
  local session="${1:-}"
  [[ -z "$session" ]] && {
    printf 'tx: _edit-tag requires a session name\n' >&2
    exit 2
  }
  local current outfile new
  current=$(tmux show-options -vt "$session" @tag 2>/dev/null)
  outfile=$(mktemp)
  trap 'rm -f "$outfile"' RETURN
  if python3 -c '
import sys, readline
session, current, outfile = sys.argv[1], sys.argv[2], sys.argv[3]
def hook():
    readline.insert_text(current)
    readline.redisplay()
readline.set_pre_input_hook(hook)
try:
    line = input(f"Tags for {session}: ")
except (EOFError, KeyboardInterrupt):
    print()
    sys.exit(1)
with open(outfile, "w") as f:
    f.write(line)
' "$session" "$current" "$outfile"; then
    new=$(<"$outfile")
    if [[ -z "$new" ]]; then
      tmux set -t "$session" -u @tag 2>/dev/null || true
    else
      tmux set -t "$session" @tag "$new"
    fi
  fi
}

jump_to_session() {
  local session="${1:-}" target target_session current_session
  local origin_pane origin_cmd
  [[ -z "$session" ]] && return 1
  if ! tmux has-session -t "=$session" 2>/dev/null; then
    printf "tx: session '%s' does not exist\n" "$session" >&2
    return 1
  fi
  current_session=$(tmux display-message -p '#S' 2>/dev/null)
  if [[ "$current_session" == "$session" ]]; then
    return 0
  fi
  # Outside tmux, display-message returns the most-recently-active client's pane.
  origin_pane=""
  [[ -n "${TMUX:-}" ]] && origin_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
  target=$(tmux-pane-for-session "$session" "$current_session" 2>/dev/null)
  if [[ -n "$target" ]]; then
    target_session="${target%%:*}"
    if [[ "$target_session" == "$current_session" ]]; then
      tmux select-window -t "$target" 2>/dev/null || return 1
      tmux select-pane -t "$target" 2>/dev/null || return 1
      return 0
    fi
  fi
  if [[ -n "$origin_pane" ]] && is_view_session "$current_session"; then
    origin_cmd=$(tmux display-message -t "$origin_pane" -p '#{pane_current_command}' 2>/dev/null)
    case "$origin_cmd" in
    zsh | bash | sh | fish | dash)
      # Trailing `exec $SHELL` keeps the pane alive after detach.
      tmux respawn-pane -k -t "$origin_pane" \
        "TMUX= tmux attach -t $(printf '%q' "$session"); exec \${SHELL:-zsh}"
      return 0
      ;;
    esac
  fi
  tmux switch-client -t "$session" 2>/dev/null
}

cmd_pick() {
  local self="$0"
  local query=""
  if [[ "${1:-}" == "-f" || "${1:-}" == "--filter" ]]; then
    [[ -z "${2:-}" ]] && {
      printf 'tx: -f requires a value\n' >&2
      exit 2
    }
    query="$2"
    shift 2
  fi

  local refresh_interval=1
  local list_args=""
  if ((MIX)); then
    refresh_interval=5
    list_args="--all"
  elif [[ -n "$HOST" ]]; then
    refresh_interval=5
    list_args="--host ${HOST}"
  fi

  # Arm file for the two-press ctrl-d kill: contains the name of the row armed
  # by the last Ctrl-D. Empty/missing means "not armed". Cleaned up when the
  # picker exits and zeroed on every focus change (cursor move disarms).
  local arm_file
  arm_file=$(mktemp -t tx-kill-arm.XXXXXX 2>/dev/null) || arm_file="/tmp/tx-kill-arm.$$"
  : >"$arm_file"
  export TX_ARM_FILE="$arm_file"
  trap 'rm -f "$arm_file"' RETURN

  # Size the NAME column to fit the current view + current longest name.
  # Exported so reload-sync subshells (`tx _list`) keep the same width.
  local cols_now longest
  cols_now=$(detect_term_cols)
  longest=$(measure_max_name)
  NAMEW=$(compute_namew "$cols_now" "$longest")
  export NAMEW

  local header_cols
  header_cols=$(printf '%-*s   STARTED IDLE   TAGS' "$NAMEW" NAME)
  # Focus header: bold ACCENT name + bold FG tag chips on line 1 (mirrors the
  # active-pane title style), column header on line 2.
  local focus_cmd="printf '${ACCENT_ANSI}${B}%s${R} ${FG_ANSI}${B}%s${R}\\n%s' {1} {2} '$header_cols'"
  # Armed header: same two-line shape — line 1 swapped for a bold yellow kill
  # prompt, line 2 keeps the column header so the layout doesn't shift.
  # Square brackets (not parens) — fzf would close the action arg on `)`.
  local arm_header_cmd="printf '${WARN_ANSI}${B} ⚠  Kill \"%s\"? [y/N]${R}\\n%s' {1} '$header_cols'"
  local opts=(
    fzf --exact --ansi --prompt='  ❯ ' --height=100% --reverse
    --delimiter=$'\t' --with-nth=4..
    --listen --track
    "--color=fg:${DIM_FG_HEX},pointer:${ACCENT_HEX},fg+:${BG_DEEP_HEX}:bold,bg+:${ACCENT_HEX},hl:${ACCENT_HEX},hl+:${BG_DEEP_HEX},header:${DIM_FG_HEX},footer:${DIM_FG_HEX},prompt:${DIM_FG_HEX},query:${FG_HEX}"
    --header="$header_cols"
    --query="$query"
    # Refresh loop + unbind y/n immediately on start so they fall through to
    # default query input until Ctrl-D arms a session. ESC is intentionally
    # left alone so it always aborts the picker (matches user expectation —
    # `n` and cursor-move handle the in-picker cancel).
    --bind="start:execute-silent(( while sleep ${refresh_interval}; do curl -fsS -XPOST \"localhost:\$FZF_PORT\" -d \"reload-sync(${self} ${list_args} _list)\" >/dev/null 2>&1 || exit 0; done ) &)+unbind(y,n)"
    --bind="ctrl-r:reload-sync(${self} ${list_args} _list)"
    # Cursor move re-renders the focus header, clears the arm file, and unbinds
    # the confirm keys — so navigating away always disarms cleanly.
    --bind="focus:transform-header($focus_cmd)+execute-silent(: >\"\$TX_ARM_FILE\")+unbind(y,n)"
  )
  if [[ -z "$HOST" ]] && ((!MIX)); then
    opts+=(
      --bind="ctrl-t:execute(tmux display-popup -E -h 5 -w 60% \"${self} _edit-tag {1}\")+reload-sync(${self} _list)"
      # tmux-style y/N kill: Ctrl-D records the row in $TX_ARM_FILE, swaps line
      # 1 of the header for the yellow prompt, and rebind()s y/n to handle the
      # answer. y kills + reloads. n / cursor-move cancel and restore the
      # normal focus header. After firing or cancelling, y/n unbind themselves.
      # No nested popup.
      --bind="ctrl-d:execute-silent(printf '%s' {1} >\"\$TX_ARM_FILE\")+transform-header($arm_header_cmd)+rebind(y,n)"
      --bind="y:execute-silent(tmux kill-session -t {1} 2>/dev/null; : >\"\$TX_ARM_FILE\")+reload-sync(${self} _list)+unbind(y,n)"
      --bind="n:transform-header($focus_cmd)+execute-silent(: >\"\$TX_ARM_FILE\")+unbind(y,n)"
    )
  fi

  local pane="${TMUX_PANE:-}"
  while :; do
    pick=$(sessions_with_meta | "${opts[@]}")
    local status=$?
    [[ $status -ne 0 ]] && return 0
    name=$(printf '%s' "$pick" | cut -f1)
    origin=$(printf '%s' "$pick" | cut -f3)
    if ((JUMP_MODE)); then
      if jump_to_session "$name"; then
        return 0
      fi
      printf 'tx: could not jump to or switch to session %s\n' "$name" >&2
      sleep 1.2
      continue
    fi
    if [[ "$origin" == "R" ]]; then
      local remote_alias="${HOST:-$MIX_REMOTE_ALIAS}"
      [[ -n "$pane" ]] && tmux set -p -t "$pane" @remote-session "$name" 2>/dev/null
      ssh -t "$remote_alias" /opt/homebrew/bin/tmux a -t "$name"
      [[ -n "$pane" ]] && tmux set -p -t "$pane" -u @remote-session 2>/dev/null
    else
      if ! tmux has-session -t "=$name" 2>/dev/null; then
        printf "tx: session '%s' does not exist\n" "$name" >&2
        sleep 1.2
        continue
      fi
      local origin_pane origin_cmd current_session
      origin_pane=""
      current_session=""
      if [[ -n "${TMUX:-}" ]]; then
        origin_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
        current_session=$(tmux display-message -p '#S' 2>/dev/null)
      fi
      if [[ -n "$origin_pane" ]] && is_view_session "$current_session"; then
        origin_cmd=$(tmux display-message -t "$origin_pane" -p '#{pane_current_command}' 2>/dev/null)
        case "$origin_cmd" in
        zsh | bash | sh | fish | dash)
          tmux respawn-pane -k -t "$origin_pane" \
            "TMUX= tmux attach -t $(printf '%q' "$name"); exec \${SHELL:-zsh}"
          return 0
          ;;
        esac
      fi
      if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$name"
      else
        TMUX= tmux attach -t "$name"
      fi
    fi
  done
}

cmd_help() {
  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
}

# tx start — ensure the Views home-base session exists, warm the tx-assistant,
# then attach Views. --restart kills an existing tx-assistant first so warmup
# recreates it fresh.
cmd_start() {
  local restart=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      cmd_help
      exit 0
      ;;
    -r | --restart)
      restart=1
      shift
      ;;
    *)
      printf 'tx start: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
    esac
  done

  local self_dir repo_dir
  self_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
  repo_dir=$(cd "$self_dir/.." && pwd)

  if ((restart)) && tmux has-session -t "=tx-assistant" 2>/dev/null; then
    tmux kill-session -t "tx-assistant"
  fi

  if tmux has-session -t "=tx-assistant" 2>/dev/null; then
    echo "tx-assistant already running."
  else
    "$self_dir/tx-assistant" --warm
    echo "tx-assistant session created."
  fi

  # Ensure the Views home-base session exists. Views is the outer session
  # the user lives in and uses `tx attach` to nest inner sessions into. It
  # is intentionally filtered out of the tx picker (see list_raw / sessions_with_meta).
  # The initial pane is a plain shell — Views is just a stable surface to
  # nest-attach into; pick a target with `tx attach` once inside.
  if ! tmux has-session -t "=Views" 2>/dev/null; then
    tmux new-session -d -s "Views" -c "$repo_dir" \
      -e COLORTERM=truecolor -e TERM=xterm-256color \
      "${SHELL:-zsh}"
    tmux set -t Views @tag "views"
    tmux set -t Views @kind "view"
    echo "Views session created."
  fi

  # Attach Views — switch-client if we're already inside tmux, otherwise
  # plain attach. switch-client only works for the calling client; running
  # from a non-tmux shell falls through to attach.
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t Views
  else
    tmux attach -t Views
  fi
}

# Default cwd from the calling pane's pwd (inside tmux) or $PWD.
spawn_default_cwd() {
  local cwd=""
  [[ -n "${TMUX:-}" ]] && cwd=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
  [[ -z "$cwd" ]] && cwd="$PWD"
  printf '%s' "$cwd"
}

# tx spawn — bare detached tmux session with a mandatory --tag.
cmd_spawn() {
  local name="" tag="" cwd="" cmd_str=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      cmd_help
      exit 0
      ;;
    --tag)
      [[ -z "${2:-}" ]] && { printf 'tx spawn: --tag requires a value\n' >&2; exit 2; }
      tag="$2"
      shift 2
      ;;
    --cwd)
      [[ -z "${2:-}" ]] && { printf 'tx spawn: --cwd requires a value\n' >&2; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --cmd)
      [[ -z "${2:-}" ]] && { printf 'tx spawn: --cmd requires a value\n' >&2; exit 2; }
      cmd_str="$2"
      shift 2
      ;;
    -*)
      printf 'tx spawn: unknown flag: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      if [[ -z "$name" ]]; then
        name="$1"
        shift
      else
        printf "tx spawn: too many positional args: '%s'\n" "$1" >&2
        exit 2
      fi
      ;;
    esac
  done

  [[ -z "$name" ]] && { printf 'tx spawn: <name> required\n' >&2; exit 2; }
  [[ -z "$tag" ]] && { printf 'tx spawn: --tag required\n' >&2; exit 2; }
  if tmux has-session -t "=$name" 2>/dev/null; then
    printf "tx spawn: session '%s' already exists\n" "$name" >&2
    exit 1
  fi
  [[ -z "$cwd" ]] && cwd=$(spawn_default_cwd)
  [[ -z "$cmd_str" ]] && cmd_str="${SHELL:-zsh}"

  tmux new-session -d -s "$name" -c "$cwd" \
    -e COLORTERM=truecolor -e TERM=xterm-256color \
    "$cmd_str"
  tmux set -t "$name" @tag "$tag"
  printf "Spawned '%s' (cwd=%s, tag=%s)\n" "$name" "$cwd" "$tag"
}

# tx spawn-nvim — detached nvim companion. Forces tokyonight-moon (dark) via
# +CMD because `tmux new-session -d` strips the terminal's OSC11 background
# hint, and nvim's auto-mode would otherwise land on the light variant.
cmd_spawn_nvim() {
  local name="" tag="" cwd="" diff_base="" has_diff=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      cmd_help
      exit 0
      ;;
    --tag)
      [[ -z "${2:-}" ]] && { printf 'tx spawn-nvim: --tag requires a value\n' >&2; exit 2; }
      tag="$2"
      shift 2
      ;;
    --cwd)
      [[ -z "${2:-}" ]] && { printf 'tx spawn-nvim: --cwd requires a value\n' >&2; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --diff)
      has_diff=1
      diff_base="main"
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        diff_base="$2"
        shift
      fi
      shift
      ;;
    -*)
      printf 'tx spawn-nvim: unknown flag: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      if [[ -z "$name" ]]; then
        name="$1"
        shift
      else
        printf "tx spawn-nvim: too many positional args: '%s'\n" "$1" >&2
        exit 2
      fi
      ;;
    esac
  done

  [[ -z "$name" ]] && { printf 'tx spawn-nvim: <name> required\n' >&2; exit 2; }
  [[ -z "$tag" ]] && { printf 'tx spawn-nvim: --tag required\n' >&2; exit 2; }
  if tmux has-session -t "=$name" 2>/dev/null; then
    printf "tx spawn-nvim: session '%s' already exists\n" "$name" >&2
    exit 1
  fi
  [[ -z "$cwd" ]] && cwd=$(spawn_default_cwd)

  local nvim_cmd="nvim +'set background=dark | colorscheme tokyonight-moon'"
  if ((has_diff)); then
    nvim_cmd="$nvim_cmd +'DiffviewOpen $diff_base'"
  fi

  tmux new-session -d -s "$name" -c "$cwd" \
    -e COLORTERM=truecolor -e TERM=xterm-256color \
    "$nvim_cmd"
  tmux set -t "$name" @tag "$tag"
  printf "Spawned nvim '%s' (cwd=%s, tag=%s%s)\n" \
    "$name" "$cwd" "$tag" "$( ((has_diff)) && printf ', diff=%s' "$diff_base" )"
}

# tx spawn-view — detached tmux session marked @kind=view so it surfaces under
# VIEWS (not PROCESSES) and is filtered out of the picker. --tag defaults to
# "views" when omitted.
cmd_spawn_view() {
  local name="" tag="" cwd="" cmd_str=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      cmd_help
      exit 0
      ;;
    --tag)
      [[ -z "${2:-}" ]] && { printf 'tx spawn-view: --tag requires a value\n' >&2; exit 2; }
      tag="$2"
      shift 2
      ;;
    --cwd)
      [[ -z "${2:-}" ]] && { printf 'tx spawn-view: --cwd requires a value\n' >&2; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --cmd)
      [[ -z "${2:-}" ]] && { printf 'tx spawn-view: --cmd requires a value\n' >&2; exit 2; }
      cmd_str="$2"
      shift 2
      ;;
    -*)
      printf 'tx spawn-view: unknown flag: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      if [[ -z "$name" ]]; then
        name="$1"
        shift
      else
        printf "tx spawn-view: too many positional args: '%s'\n" "$1" >&2
        exit 2
      fi
      ;;
    esac
  done

  [[ -z "$name" ]] && { printf 'tx spawn-view: <name> required\n' >&2; exit 2; }
  [[ -z "$tag" ]] && tag="views"
  if tmux has-session -t "=$name" 2>/dev/null; then
    printf "tx spawn-view: session '%s' already exists\n" "$name" >&2
    exit 1
  fi
  [[ -z "$cwd" ]] && cwd=$(spawn_default_cwd)
  [[ -z "$cmd_str" ]] && cmd_str="${SHELL:-zsh}"

  tmux new-session -d -s "$name" -c "$cwd" \
    -e COLORTERM=truecolor -e TERM=xterm-256color \
    "$cmd_str"
  tmux set -t "$name" @tag "$tag"
  tmux set -t "$name" @kind "view"
  printf "Spawned view '%s' (cwd=%s, tag=%s)\n" "$name" "$cwd" "$tag"
}

# tx mailbox — exec the Python curses TUI in lib/.
# Prefer /usr/bin/python3 over PATH lookup because the latter usually lands
# on pyenv's shim, which adds ~60ms per launch — the dominant cost of
# prefix+m. Fall back to PATH only if system python is missing.
cmd_mailbox() {
  local self_dir py
  self_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
  if [[ -x /usr/bin/python3 ]]; then
    py=/usr/bin/python3
  else
    py=$(command -v python3) || {
      printf 'tx: python3 not found\n' >&2
      exit 1
    }
  fi
  exec "$py" "$self_dir/../lib/tx-mailbox" "$@"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --all)
    MIX=1
    shift
    ;;
  --jump | -j)
    JUMP_MODE=1
    shift
    ;;
  --host)
    # Alias is optional; defaults to `personal`. Treat a following arg as the
    # alias only when it doesn't look like a flag (`-…`) or hidden subcommand (`_…`).
    if [[ -n "${2:-}" && "${2:0:1}" != "-" && "${2:0:1}" != "_" ]]; then
      HOST="$2"
      shift 2
    else
      HOST="personal"
      shift
    fi
    ;;
  *) break ;;
  esac
done

case "${1:-}" in
"" | -h | --help | help) cmd_help ;;
attach)
  shift
  cmd_pick "$@"
  ;;
ls)
  shift
  cmd_ls "$@"
  ;;
mailbox)
  shift
  cmd_mailbox "$@"
  ;;
start)
  shift
  cmd_start "$@"
  ;;
spawn)
  shift
  cmd_spawn "$@"
  ;;
spawn-nvim)
  shift
  cmd_spawn_nvim "$@"
  ;;
spawn-view)
  shift
  cmd_spawn_view "$@"
  ;;
_list)
  shift
  cmd_list "$@"
  ;;
_edit-tag)
  shift
  cmd_edit_tag "$@"
  ;;
*)
  printf 'tx: unknown command: %s\n\n' "$1" >&2
  cmd_help
  exit 2
  ;;
esac
