#!/usr/bin/env bash
# tx-ide CLI shim (stage S0) — the thin entrypoint; all logic is in the Python package (lib/tx).
#
# Resolves this script's repo from its OWN location (following symlinks, since it is installed as
# ~/.local/bin/tx → repo/bin/tx) so PYTHONPATH points at the bundled lib/ regardless of cwd, then
# execs the package. This is the C9 rule: bin/tx finds the repo from its location; $TX_IDE_HOME is
# resolved inside the package (env var, default ~/.tx-ide). An exported $TX_IDE_HOME still
# overrides — e.g. `TX_IDE_HOME=~/.tx-ide-next tx ...` for the coexistence dev home.
set -euo pipefail

# Follow symlinks to the real script path.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
  source="$(readlink "$source")"
  [[ "$source" != /* ]] && source="$dir/$source"
done
bin_dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
repo_root="$(cd -P "$bin_dir/.." >/dev/null 2>&1 && pwd)"

exec env PYTHONPATH="$repo_root/lib${PYTHONPATH:+:$PYTHONPATH}" python3.14 -m tx "$@"
