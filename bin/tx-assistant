#!/usr/bin/env bash
# tx-assistant — forward one line of input to the tx-assistant session.
# Bound to prefix+/ via tmux/tx-ide.tmux.
# Pass --warm to ensure the session exists (and send priming if freshly
# created) without forwarding any input — used by `tx start`.
set -u

warm_only=0
if [ "${1:-}" = "--warm" ]; then
  warm_only=1
  input=""
else
  input="${1:-}"
  [ -z "${input// /}" ] && exit 0
fi

session=tx-assistant
priming='Read ~/.tx-ide/agents/COMMON.md and ~/.tx-ide/agents/TX-ASSISTANT.md as your first actions. Then, if they exist, also read ~/.tx-ide/user-agents/COMMON.md, ~/.tx-ide/user-agents/COMMON.local.md, ~/.tx-ide/user-agents/TX-ASSISTANT.md, and ~/.tx-ide/user-agents/TX-ASSISTANT.local.md (any user-agents/X.md replaces the shipped one; any user-agents/X.local.md extends it). Follow all of these for the duration of this session. Then snap-act on every turn — one plausible reading, one command, done; no deliberation, no re-reading the doc on routine ops.'

repo=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")

xml_escape() {
  local raw="$1"
  raw="${raw//&/&amp;}"
  raw="${raw//\'/&apos;}"
  raw="${raw//</&lt;}"
  raw="${raw//>/&gt;}"
  printf '%s' "$raw"
}

attr() {
  printf " %s='%s'" "$1" "$(xml_escape "$2")"
}

build_envelope() {
  [ -z "${TMUX:-}" ] && return 0

  # run-shell does not set $TMUX_PANE — fall back to the firing client's pane.
  local target_pane="${TMUX_PANE:-}"
  [ -z "$target_pane" ] && target_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
  [ -z "$target_pane" ] && return 0

  local format='#{session_name}|#{window_index}|#{window_name}|#{pane_index}|#{pane_title}|#{pane_current_command}|#{pane_current_path}|#{pane_tty}'
  local line
  line=$(tmux display-message -t "$target_pane" -p "$format" 2>/dev/null) || return 0
  [ -z "$line" ] && return 0

  local session_name window_index window_name pane_index pane_title pane_command pane_path pane_tty
  IFS='|' read -r session_name window_index window_name pane_index pane_title pane_command pane_path pane_tty <<<"$line"
  local pane_id="$target_pane"

  local session_kind session_tag
  session_kind=$(tmux show-options -vqt "$session_name" @kind 2>/dev/null) || session_kind=""
  session_tag=$(tmux show-options -vqt "$session_name" @tag 2>/dev/null) || session_tag=""

  local envelope="<tx-command-prompt"
  envelope+=$(attr session-name "$session_name")
  envelope+=$(attr session-kind "$session_kind")
  envelope+=$(attr session-tag "$session_tag")
  envelope+=$(attr window-index "$window_index")
  envelope+=$(attr window-name "$window_name")
  envelope+=$(attr pane-id "$pane_id")
  envelope+=$(attr pane-index "$pane_index")
  envelope+=$(attr pane-title "$pane_title")
  envelope+=$(attr pane-cmd "$pane_command")
  envelope+=$(attr pane-path "$pane_path")

  # Nest-attach detection mirrors bin/tmux-pane-session-name. @remote-session
  # marks an ssh-attached remote tmux — skip inner introspection (needs ssh).
  local remote_session
  remote_session=$(tmux show-options -pqv -t "$pane_id" @remote-session 2>/dev/null) || remote_session=""
  if [ -n "$remote_session" ]; then
    envelope+=$(attr inner-remote "1")
    envelope+=$(attr inner-session-name "$remote_session")
  else
    local inner_session
    inner_session=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null |
      awk -v t="$pane_tty" '$1==t {print $2; exit}')
    if [ -n "$inner_session" ]; then
      local inner_kind inner_tag inner_info
      inner_kind=$(tmux show-options -vqt "$inner_session" @kind 2>/dev/null) || inner_kind=""
      inner_tag=$(tmux show-options -vqt "$inner_session" @tag 2>/dev/null) || inner_tag=""
      inner_info=$(tmux display-message -t "$inner_session" -p \
        '#{window_index}|#{window_name}|#{pane_id}|#{pane_index}|#{pane_title}|#{pane_current_command}|#{pane_current_path}' \
        2>/dev/null) || inner_info=""
      local inner_window_index inner_window_name inner_pane_id inner_pane_index inner_pane_title inner_pane_command inner_pane_path
      IFS='|' read -r inner_window_index inner_window_name inner_pane_id inner_pane_index inner_pane_title inner_pane_command inner_pane_path <<<"$inner_info"
      envelope+=$(attr inner-session-name "$inner_session")
      envelope+=$(attr inner-session-kind "$inner_kind")
      envelope+=$(attr inner-session-tag "$inner_tag")
      envelope+=$(attr inner-window-index "$inner_window_index")
      envelope+=$(attr inner-window-name "$inner_window_name")
      envelope+=$(attr inner-pane-id "$inner_pane_id")
      envelope+=$(attr inner-pane-index "$inner_pane_index")
      envelope+=$(attr inner-pane-title "$inner_pane_title")
      envelope+=$(attr inner-pane-cmd "$inner_pane_command")
      envelope+=$(attr inner-pane-path "$inner_pane_path")
    fi
  fi

  envelope+="/>"
  printf '%s' "$envelope"
}

ensure_session() {
  if tmux has-session -t "=$session" 2>/dev/null; then
    echo existed
    return
  fi
  tmux new-session -d -s "$session" -c "$repo" \
    -e COLORTERM=truecolor -e TERM=xterm-256color \
    "claude --model haiku --effort low --dangerously-skip-permissions"
  tmux set -t "$session" @tag "tx-system"
  # Wait for claude's input box to render (its prefix char is `❯`, not `>`).
  for _ in $(seq 1 20); do
    tmux capture-pane -p -t "$session" 2>/dev/null | grep -q '❯ ' && break
    sleep 0.5
  done
  echo created
}

state=$(ensure_session)

if [ "$warm_only" -eq 1 ]; then
  if [ "$state" = created ]; then
    tmux send-keys -t "$session" -l -- "$priming"
    sleep 0.3
    tmux send-keys -t "$session" Enter
  fi
  exit 0
fi

envelope=$(build_envelope)
[ -n "$envelope" ] && input="$envelope $input"

if [ "$state" = created ]; then
  input="$priming Now: $input"
fi

tmux send-keys -t "$session" -l -- "$input"
sleep 0.3
tmux send-keys -t "$session" Enter
exit 0
