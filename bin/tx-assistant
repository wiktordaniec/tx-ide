#!/usr/bin/env bash
# tx-assistant — forward one line of input to the assistant session.
#
# Invoked by the `prefix+/` tmux binding (see tmux/tx-ide.tmux). Spawns the
# persistent `assistant` session on first call, then `send-keys`'s the user's
# line into it and exits. No round-trip — the user attaches via `tx attach`
# (filter on `assistant`) if they want to see the reply.
#
# Cold-start priming is inlined into the first user message (rather than
# passed as claude's positional arg) so there is no race between claude
# digesting a separate "you are the assistant" turn and our `send-keys`
# landing the user's actual ask. Subsequent presses send only the user input.
set -u

input="${1:-}"
[ -z "${input// /}" ] && exit 0

session=assistant
priming='You are the tx-ide assistant. Each user line is one tmux or tx operation. Execute it skillfully and stop. Do not ask clarifying questions — pick a reasonable interpretation and run it.'

if ! tmux has-session -t "=$session" 2>/dev/null; then
  tmux new-session -d -s "$session" -c "$HOME" \
    -e COLORTERM=truecolor -e TERM=xterm-256color \
    "claude --model haiku --effort low --dangerously-skip-permissions"
  tmux set -t "$session" @tag "system,assistant"
  # Wait for claude's input box to render (its prefix char is `❯`, not `>`).
  for _ in $(seq 1 20); do
    tmux capture-pane -p -t "$session" 2>/dev/null | grep -q '❯ ' && break
    sleep 0.5
  done
  input="$priming Now: $input"
fi

tmux send-keys -t "$session" -l -- "$input"
sleep 0.3
tmux send-keys -t "$session" Enter
exit 0
