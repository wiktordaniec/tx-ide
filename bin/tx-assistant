#!/usr/bin/env bash
# tx-assistant — forward one line of input to the tx-assistant session.
# Bound to prefix+/ via tmux/tx-ide.tmux.
#   --from-buffer   input is the tx-assistant-input tmux paste buffer
#                   (set by the prefix+/ binding to avoid shell-escaping
#                   the command-prompt value)
#   --warm          ensure the session exists (and send priming if freshly
#                   created) without forwarding any input — used by `tx start`
set -u

buffer=tx-assistant-input
warm_only=0
case "${1:-}" in
--from-buffer)
  input=$(tmux show-buffer -b "$buffer" 2>/dev/null) || input=""
  tmux delete-buffer -b "$buffer" 2>/dev/null || true
  ;;
--warm)
  warm_only=1
  input=""
  ;;
*)
  printf 'tx-assistant: unknown invocation; pass --warm or --from-buffer\n' >&2
  exit 2
  ;;
esac

if [ "$warm_only" -eq 0 ]; then
  [ -z "${input// /}" ] && exit 0
fi

session=tx-assistant
priming='Read ~/.tx-ide/agents/COMMON.md and ~/.tx-ide/agents/TX-ASSISTANT.md as your first actions. Then, if they exist, also read ~/.tx-ide/user-agents/COMMON.md, ~/.tx-ide/user-agents/COMMON.local.md, ~/.tx-ide/user-agents/TX-ASSISTANT.md, and ~/.tx-ide/user-agents/TX-ASSISTANT.local.md (any user-agents/X.md replaces the shipped one; any user-agents/X.local.md extends it). Follow all of these for the duration of this session.'

repo=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
tx_session_state="$repo/lib/tx-session-state"
tx_python=$(command -v python3.14)

build_envelope() {
  [ -z "${TMUX:-}" ] && return 0

  # run-shell does not set $TMUX_PANE — fall back to the firing client's pane.
  local target_pane="${TMUX_PANE:-}"
  [ -z "$target_pane" ] && target_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
  [ -z "$target_pane" ] && return 0

  # S6: the envelope is now built by the Python package's unified attachment join (M-focus,
  # attachment-topology §6) — this replaces the old inline client_tty→session awk and the
  # tx-session-state kind/tag lookups. Call this checkout's tx (repo-relative) so it tracks the
  # installed code regardless of $PATH during coexistence; stdout is the <tx-command-prompt/>.
  "$repo/bin/tx" focus-envelope "$target_pane" 2>/dev/null || true
}

ensure_session() {
  if tmux has-session -t "=$session" 2>/dev/null; then
    echo existed
    return
  fi
  local claude_cmd="claude --model sonnet --effort low --dangerously-skip-permissions"
  local parent pid id
  id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  parent=$(tmux display-message -p '#S' 2>/dev/null) || parent=""
  pid=$(tmux new-session -d -P -F '#{pane_pid}' -s "$session" -c "$repo" \
    -e COLORTERM=truecolor -e TERM=xterm-256color \
    -e "TX_SESSION_ID=$id" \
    "$claude_cmd")
  "$tx_python" "$tx_session_state" new --id "$id" --name "$session" --kind "" --tags "tx-system" \
    --cwd "$repo" --cmd "$claude_cmd" --parent "$parent" --pid "$pid" >/dev/null
  tmux set -t "$session" @tx_id "$id"
  # Wait for claude's input box to render (its prefix char is `❯`, not `>`).
  for _ in $(seq 1 20); do
    tmux capture-pane -p -t "$session" 2>/dev/null | grep -q '❯ ' && break
    sleep 0.5
  done
  echo created
}

state=$(ensure_session)

if [ "$warm_only" -eq 1 ]; then
  if [ "$state" = created ]; then
    tmux send-keys -t "$session" -l -- "$priming"
    sleep 0.3
    tmux send-keys -t "$session" Enter
  fi
  exit 0
fi

envelope=$(build_envelope)
[ -n "$envelope" ] && input="$envelope $input"

if [ "$state" = created ]; then
  input="$priming Now: $input"
fi

tmux send-keys -t "$session" -l -- "$input"
sleep 0.3
tmux send-keys -t "$session" Enter
exit 0
