#!/usr/bin/env bash
# tx-leader — spawn (or report) a leader Claude Code session in tmux.
#
# Usage:
#   tx-leader                          Use $PWD as the project; session name `leader`.
#   tx-leader --project DIR            Set the project working directory.
#   tx-leader --session-name NAME      Use NAME instead of `leader`.
#   tx-leader --help
#
# The leader is primed with:
#   ~/.tx-ide/agents/COMMON.md  +  ~/.tx-ide/agents/LEADER.md
# and, if present, the matching files in ~/.tx-ide/user-agents/ (user overrides
# or *.local.md companions). If the session already exists, prints the attach
# command and exits.
set -u

SESSION_NAME="${LEADER_SESSION_NAME:-leader}"
PROJECT_DIR="$PWD"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project)        PROJECT_DIR="$2"; shift 2 ;;
    --session-name)   SESSION_NAME="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      printf 'tx-leader: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  echo "Leader session '$SESSION_NAME' already running."
  echo "Attach with: tmux attach -t $SESSION_NAME"
  echo "Or: tx (filter by 'leader')"
  exit 0
fi

# Single line, no quotes or special chars — long/complex prompts crash tmux.
PRIMING_PROMPT='Read ~/.tx-ide/agents/COMMON.md and ~/.tx-ide/agents/LEADER.md as your first actions. Then, if they exist, also read ~/.tx-ide/user-agents/COMMON.local.md, ~/.tx-ide/user-agents/COMMON.md, ~/.tx-ide/user-agents/LEADER.local.md, and ~/.tx-ide/user-agents/LEADER.md (any user-agents/X.md replaces the shipped one; any user-agents/X.local.md extends it). Follow all of these for the duration of this session.'

# Try resume first (preserves prior conversation); on fresh start, pass the
# priming prompt. Passed via env var to avoid quoting nightmares in tmux's
# command argument.
tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" \
  -e COLORTERM=truecolor -e TERM=xterm-256color \
  -e TX_LEADER_PROMPT="$PRIMING_PROMPT" \
  'claude --continue || claude "$TX_LEADER_PROMPT"'

tmux set -t "$SESSION_NAME" @tag "leader,llm"

echo "Leader started in tmux session '$SESSION_NAME' (cwd: $PROJECT_DIR)."
echo "Attach with: tmux attach -t $SESSION_NAME"
echo "Or run 'tx' and pick it."
