#!/usr/bin/env bash
# Print a pane hosting session $1 (via nested attach or @remote-session) as
# `session:window.pane`. $2 = comma-separated preferred sessions; match wins.
target="${1:-}"
prefer_csv="${2:-}"
[[ -z "$target" ]] && exit 2

{
  tmux list-clients -F 'C	#{client_tty}	#{client_session}' 2>/dev/null
  tmux list-panes -a -F 'P	#{pane_tty}	#{session_name}	#{window_index}	#{pane_index}	#{@remote-session}' 2>/dev/null
} | awk -F'\t' -v target="$target" -v prefer_csv="$prefer_csv" '
  $1 == "C" {
    if ($2 != "") client_session[$2] = $3
    next
  }
  $1 == "P" {
    pane_tty = $2; session = $3; window = $4; pane = $5; override = $6
    match_str = session ":" window "." pane
    if (override != "") {
      if (override == target && remote_fallback == "")
        remote_fallback = match_str
      next
    }
    inner = client_session[pane_tty]
    if (inner != "" && inner == target) {
      if (prefer_csv != "" && index("," prefer_csv ",", "," session ",") > 0) {
        print match_str
        printed = 1
        exit 0
      }
      if (any_match == "") any_match = match_str
    }
  }
  END {
    if (printed) exit 0
    if (any_match != "") { print any_match; exit 0 }
    if (remote_fallback != "") { print remote_fallback; exit 0 }
    exit 1
  }
'
