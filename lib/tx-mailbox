def tag_color_index(tag_value):
    hash_value = 0
    for character in tag_value:
        hash_value = (hash_value * 31 + ord(character)) % 2147483647
    return hash_value % TAG_PALETTE_SIZE


def tag_style_key(tag_value, selected=False):
    prefix = "selected_tag" if selected else "entry_tag"
    return f"{prefix}_{tag_color_index(tag_value)}"


def load_entries():
    if not INBOX_FILE.exists():
        return []
    entries = []
    with INBOX_FILE.open() as inbox_handle:
        for raw_line in inbox_handle:
            stripped = raw_line.strip()
            if not stripped:
                continue
            entries.append(json.loads(stripped))
    entries.sort(key=lambda entry: entry["timestamp"], reverse=True)
    return entries


def write_entries(entries):
    if not entries:
        INBOX_FILE.write_text("")
        return
    INBOX_FILE.write_text("\n".join(json.dumps(entry) for entry in entries) + "\n")


def mark_read(entry_id):
    if not INBOX_FILE.exists():
        return
    entries = []
    with INBOX_FILE.open() as inbox_handle:
        for raw_line in inbox_handle:
            stripped = raw_line.strip()
            if not stripped:
                continue
            entry = json.loads(stripped)
            if entry["id"] == entry_id:
                entry["read"] = True
            entries.append(entry)
    write_entries(entries)


def mark_all_read():
    if not INBOX_FILE.exists():
        return
    entries = []
    with INBOX_FILE.open() as inbox_handle:
        for raw_line in inbox_handle:
            stripped = raw_line.strip()
            if not stripped:
                continue
            entry = json.loads(stripped)
            entry["read"] = True
            entries.append(entry)
    write_entries(entries)


def has_tmux_session(name):
    try:
        result = subprocess.run(
            ["tmux", "has-session", "-t", f"={name}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return result.returncode == 0
    except FileNotFoundError:
        return False


def jump_to_session(name):
    """Focus `name`'s host pane wherever it is, returning None on success.
    Returns an error string if no host pane was found
    (read-only — `tx attach` does materializing)."""
    if not name:
        return None
    current = subprocess.run(
        ["tmux", "display-message", "-p", "#S"],
        capture_output=True,
        text=True,
        check=False,
    )
    current_session = current.stdout.strip()
    prefer_list = list(_group_members(current_session)) if current_session else []
    outer = _outer_view_session()
    if outer and outer not in prefer_list:
        prefer_list.append(outer)
    prefer = ",".join(prefer_list)
    try:
        helper = subprocess.run(
            ["tmux-pane-for-session", name, prefer],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        return "tmux-pane-for-session helper not on PATH"
    target = helper.stdout.strip()
    if helper.returncode == 0 and target:
        host_session, _, window_pane = target.partition(":")
        for member in _group_members(host_session):
            member_target = f"{member}:{window_pane}"
            subprocess.run(["tmux", "select-window", "-t", member_target], check=False)
            subprocess.run(["tmux", "select-pane", "-t", member_target], check=False)
        return None

    if not has_tmux_session(name):
        return f"session '{name}' no longer exists"

    return f"session '{name}' is not attached anywhere"


def _outer_view_session():
    caller_tty = subprocess.run(
        ["tmux", "display-message", "-p", "#{client_tty}"],
        capture_output=True, text=True, check=False,
    ).stdout.strip()
    if not caller_tty:
        return None
    panes = subprocess.run(
        ["tmux", "list-panes", "-a", "-F", "#{pane_tty}|#{session_name}"],
        capture_output=True, text=True, check=False,
    )
    if panes.returncode != 0:
        return None
    for line in panes.stdout.splitlines():
        tty, _, session = line.partition("|")
        if tty == caller_tty:
            return session
    return None


def current_view_members():
    import os
    cmd = ["tmux", "display-message", "-p", "#S"]
    pane = os.environ.get("TMUX_PANE")
    if pane:
        cmd = ["tmux", "display-message", "-t", pane, "-p", "#S"]
    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    current = result.stdout.strip()
    if not current:
        return []

    clients_proc = subprocess.run(
        ["tmux", "list-clients", "-F", "#{client_tty}\t#{client_session}"],
        capture_output=True, text=True, check=False,
    )
    panes_proc = subprocess.run(
        ["tmux", "list-panes", "-a", "-F", "#{pane_tty}\t#{session_name}"],
        capture_output=True, text=True, check=False,
    )
    ttys_for_session = {}
    for line in clients_proc.stdout.splitlines():
        tty, _, sess = line.partition("\t")
        if tty and sess:
            ttys_for_session.setdefault(sess, set()).add(tty)
    parent_of = {}
    for line in panes_proc.stdout.splitlines():
        pane_tty, _, host_session = line.partition("\t")
        for inner_session, ttys in ttys_for_session.items():
            if pane_tty in ttys:
                parent_of.setdefault(inner_session, host_session)

    def kind_of(session):
        tx_id = subprocess.run(
            ["tmux", "show-options", "-vqt", session, "@tx_id"],
            capture_output=True, text=True, check=False,
        ).stdout.strip()
        if not tx_id:
            return ""
        record = SessionStore().load(tx_id)
        return record.kind if record else ""

    seen = set()
    while current and current not in seen:
        if kind_of(current) == "view":
            return _group_members(current)
        seen.add(current)
        current = parent_of.get(current)
    return []


def host_window_map(view_members):
    if not view_members:
        return {}, set()
    members = set(view_members)
    clients_proc = subprocess.run(
        ["tmux", "list-clients", "-F", "#{client_tty}\t#{client_session}"],
        capture_output=True,
        text=True,
        check=False,
    )
    client_session = {}
    for line in clients_proc.stdout.splitlines():
        parts = line.split("\t", 1)
        if len(parts) == 2 and parts[0]:
            client_session[parts[0]] = parts[1]
    panes_proc = subprocess.run(
        [
            "tmux", "list-panes", "-a", "-F",
            "#{pane_tty}\t#{session_name}\t#{window_index}\t#{window_name}\t#{pane_index}\t#{@remote-session}",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    in_view = {}
    attached_anywhere = set()
    for line in panes_proc.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 6:
            continue
        pane_tty, host_session, window_index, window_name, pane_index, override = parts[:6]
        nested = override or client_session.get(pane_tty, "")
        if not nested:
            continue
        attached_anywhere.add(nested)
        if host_session in members and nested not in in_view:
            in_view[nested] = (window_index, window_name, pane_index)
    return in_view, attached_anywhere


def _group_members(session_name):
    """Return all session names sharing a session group with `session_name`,
    including itself. Sessions without a group return just [session_name]."""
    result = subprocess.run(
        ["tmux", "list-sessions", "-F", "#{session_name}\t#{session_group}"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return [session_name]
    rows = []
    target_group = ""
    for line in result.stdout.splitlines():
        parts = line.split("\t", 1)
        if len(parts) < 2:
            continue
        sname, sgroup = parts[0], parts[1]
        rows.append((sname, sgroup))
        if sname == session_name:
            target_group = sgroup
    if not target_group:
        return [session_name]
    return [sname for sname, sgroup in rows if sgroup == target_group]


def load_running():
    if not RUNNING_DIR.exists():
        return []
    entries = []
    for entry_path in list(RUNNING_DIR.iterdir()):
        if entry_path.suffix != ".json":
            continue
        try:
            entry = json.loads(entry_path.read_text())
        except Exception:
            continue
        session = entry.get("tmux_session")
        if not session or not has_tmux_session(session):
            try:
                entry_path.unlink()
            except OSError:
                pass
            continue
        entries.append(entry)
    entries.sort(key=lambda entry: entry.get("timestamp", ""), reverse=True)
    return entries


def apply_view_scope(inbox_entries, running_entries, view_members):
    if not view_members:
        return inbox_entries, running_entries
    in_view, attached_anywhere = host_window_map(view_members)
    def keep(entry):
        session = entry.get("tmux_session", "")
        location = in_view.get(session)
        if location is not None:
            entry["_location"] = location
            return True
        return session not in attached_anywhere
    return (
        [entry for entry in inbox_entries if keep(entry)],
        [entry for entry in running_entries if keep(entry)],
    )


def inbox_signature():
    if INBOX_FILE.exists():
        return INBOX_FILE.stat().st_mtime
    return 0.0


def running_signature():
    if not RUNNING_DIR.exists():
        return ()
    try:
        return tuple(
            sorted((path.name, path.stat().st_mtime) for path in RUNNING_DIR.iterdir())
        )
    except OSError:
        return ()


def relative_age(timestamp_iso):
    utc_time = datetime.fromisoformat(timestamp_iso.replace("Z", "+00:00"))
    seconds = int((datetime.now(utc_time.tzinfo) - utc_time).total_seconds())
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"{seconds}s"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    if hours < 24:
        return f"{hours}h"
    days = hours // 24
    return f"{days}d"


NAME_COL_FLOOR = 12
NAME_COL_CEILING = 60
LOC_COL_HEADER = "LOCATION"
LOC_COL_CEILING = 24


def name_visible_length(entry):
    return len(entry.get("tmux_session", "") or "")


def location_text(entry):
    location = entry.get("_location")
    if location is None:
        return ""
    _window_index, window_name, pane_index = location
    return f"{window_name}[{pane_index}]"


def compute_location_col_width(rows):
    """Width for the LOCATION column, or 0 to suppress it. The column only
    renders when at least one entry has a `_location` (set by apply_view_scope
    when a View is active — archive view typically has none). Floor is the
    header width so the header is never clipped."""
    longest = 0
    for row in rows:
        if row.get("type") != "entry":
            continue
        length = len(location_text(row["data"]))
        if length > longest:
            longest = length
    if longest == 0:
        return 0
    return max(min(longest, LOC_COL_CEILING), len(LOC_COL_HEADER))


def compute_name_col_width(rows, term_width, loc_col_width):
    """Fit the widest session name across entry rows, floor 12, ceiling 60,
    capped so AT (if present), AGE, and tag chips still fit. Mirrors tx's
    compute_namew(): one stable width per render so the right-side columns
    line up."""
    longest = NAME_COL_FLOOR
    for row in rows:
        if row.get("type") != "entry":
            continue
        length = name_visible_length(row["data"])
        if length > longest:
            longest = length
    # Past NAME: 2 (gap) + [LOC + 2 (gap)] + 4 (AGE) + 2 (gap) + ~12 (tag/cwd).
    loc_overhead = (loc_col_width + 2) if loc_col_width > 0 else 0
    overhead = 2 + loc_overhead + 4 + 2 + 12
    max_w = max(NAME_COL_FLOOR, term_width - overhead)
    if max_w > NAME_COL_CEILING:
        max_w = NAME_COL_CEILING
    return max(NAME_COL_FLOOR, min(longest, max_w))


def format_entry_segments(entry, name_col_width, loc_col_width):
    """Return (text, style_key) tuples for one entry row. Column colors mirror
    tx (see tmux/palette.sh): age=WARN (yellow), session=bold FG, suffix=DIM_FG.
    Columns: NAME | (AT) | AGE | TAGS. The AT column is omitted when
    loc_col_width is 0. Tags render as individual chips [a] [b].
    """
    age = relative_age(entry["timestamp"])
    tags = entry.get("tmux_tags") or ""
    session = entry["tmux_session"]

    segments = []
    name_len = len(session)
    if name_len <= name_col_width:
        segments.append((session, "entry_session"))
        pad = name_col_width - name_len
        if pad > 0:
            segments.append((" " * pad, "entry"))
    else:
        segments.append((session[: name_col_width - 1] + "…", "entry_session"))

    if loc_col_width > 0:
        segments.append(("  ", "entry"))
        loc = location_text(entry)
        if loc:
            if len(loc) > loc_col_width:
                loc = loc[: loc_col_width - 1] + "…"
            segments.append((loc, "entry_session"))
            pad = loc_col_width - len(loc)
        else:
            pad = loc_col_width
        if pad > 0:
            segments.append((" " * pad, "entry"))

    segments.append(("  ", "entry"))
    segments.append((f"{age:>4}", "entry_age"))
    segments.append(("  ", "entry"))
    if tags:
        for index, tag_part in enumerate(tags.split(",")):
            if index > 0:
                segments.append((" ", "entry"))
            segments.append((f"[{tag_part}]", tag_style_key(tag_part)))
    else:
        segments.append((entry["cwd"].rsplit("/", 1)[-1], "entry_suffix"))
    return segments


def build_live_rows(inbox_entries, running_entries):
    rows = []
    unread = [entry for entry in inbox_entries if not entry.get("read")]
    visible_unread = unread[:LIVE_UNREAD_CAP]
    for entry in visible_unread:
        rows.append({"type": "entry", "kind": "inbox", "data": entry})
    overflow = len(unread) - len(visible_unread)
    if overflow > 0:
        rows.append({"type": "hint", "text": f"+{overflow} older in archive"})
    if not unread and running_entries:
        rows.append({"type": "hint", "text": "(no unread messages — waiting…)"})
    if visible_unread or running_entries:
        rows.append(
            {"type": "separator", "text": f"── active ({len(running_entries)}) ──"}
        )
    for entry in running_entries:
        rows.append({"type": "entry", "kind": "running", "data": entry})
    return rows


def build_archive_rows(inbox_entries):
    return [
        {"type": "entry", "kind": "inbox", "data": entry} for entry in inbox_entries
    ]


def build_rows(inbox_entries, running_entries, view_mode):
    if view_mode == "live":
        return build_live_rows(inbox_entries, running_entries)
    return build_archive_rows(inbox_entries)


def first_selectable_index(rows):
    for index, row in enumerate(rows):
        if row["type"] == "entry":
            return index
    return -1


def find_next_selectable(rows, start, direction):
    index = start + direction
    while 0 <= index < len(rows):
        if rows[index]["type"] == "entry":
            return index
        index += direction
    return start


def entry_matches(entry, query_lower):
    if not query_lower:
        return True
    name = entry.get("tmux_session", "") or ""
    tags = entry.get("tmux_tags") or ""
    return query_lower in f"{name} {tags}".casefold()


def filter_rows(rows, query):
    if not query:
        return rows
    query_lower = query.casefold()
    return [
        row
        for row in rows
        if row["type"] == "entry" and entry_matches(row["data"], query_lower)
    ]


def row_identity(row):
    if row.get("type") != "entry":
        return None
    data = row["data"]
    return (row.get("kind"), data.get("id") or data.get("tmux_session"))


def reselect_by_identity(rows, identity, fallback_index=None):
    """Find the row matching `identity`. If gone (e.g. just marked read in
    live view, where read items vanish), prefer staying at `fallback_index`
    so the next item slides into the cursor. If that slot is past the end
    or on a non-entry row, walk back to the nearest entry."""
    if identity is not None:
        for index, row in enumerate(rows):
            if row_identity(row) == identity:
                return index
    if fallback_index is not None:
        if 0 <= fallback_index < len(rows) and rows[fallback_index]["type"] == "entry":
            return fallback_index
        for index in range(min(fallback_index, len(rows)) - 1, -1, -1):
            if rows[index]["type"] == "entry":
                return index
    return first_selectable_index(rows)


def draw_segments(stdscr, line_y, width, segments, styles, override=None, key_overrides=None):
    """Write a list of (text, style_key) segments on `line_y`, padding to width.
    `override` (if set) is applied to every segment AS A DEFAULT for selected/
    read rows. `key_overrides` (if set) is a dict mapping style_key -> attr
    that wins over `override` for those specific keys — used to keep a column's
    own color even when the row is selected (e.g. yellow age on blue selection).
    """
    line_width = width - 1
    x = 0
    key_overrides = key_overrides or {}
    for text, style_key in segments:
        if x >= line_width:
            break
        remaining = line_width - x
        chunk = text[:remaining]
        if style_key in key_overrides:
            attr = key_overrides[style_key]
        elif override is not None:
            attr = override
        else:
            attr = styles[style_key]
        stdscr.addnstr(line_y, x, chunk, remaining, attr)
        x += len(chunk)
    if x < line_width:
        pad_attr = override if override is not None else styles["entry"]
        stdscr.addnstr(line_y, x, " " * (line_width - x), line_width - x, pad_attr)


def draw_search_bar(stdscr, line_y, width, query, styles, search_active):
    """Draw the input marker + query on line_y; return the column for the caret.

    In command mode (search_active=False) with no query, the bar is blank so
    the UI signals that typing won't search — `/` is needed to enter search.
    """
    if width <= 1:
        return 0
    line_width = width - 1
    if not search_active and not query:
        stdscr.addnstr(line_y, 0, " " * line_width, line_width, styles["entry"])
        return 0
    prompt = SEARCH_PROMPT
    chunk = prompt[:line_width]
    stdscr.addnstr(line_y, 0, chunk, line_width, styles["search_prompt"])
    x = len(chunk)
    if x >= line_width:
        return max(0, line_width - 1)
    # Query may exceed remaining width — show the rightmost slice so the caret
    # stays visible while typing long filters.
    remaining = line_width - x
    q_display = query if len(query) <= remaining else query[-remaining:]
    stdscr.addnstr(line_y, x, q_display, remaining, styles["search_query"])
    caret_x = x + len(q_display)
    if caret_x < line_width:
        pad = line_width - caret_x
        stdscr.addnstr(line_y, caret_x, " " * pad, pad, styles["entry"])
    return min(caret_x, line_width - 1)


def render(
    stdscr,
    rows,
    cursor,
    scroll_offset,
    styles,
    view_mode,
    total_unread,
    active_count,
    query,
    error_text="",
    search_active=False,
):
    height, width = stdscr.getmaxyx()
    stdscr.erase()

    if view_mode == "live":
        header_text = f"live ({total_unread} unread · {active_count} active)"
    else:
        archive_count = sum(1 for row in rows if row["type"] == "entry")
        header_text = f"archive ({archive_count} · {total_unread} unread)"
    if query:
        match_count = sum(1 for row in rows if row["type"] == "entry")
        header_text = f"{header_text} · {match_count} matching"
    stdscr.addnstr(
        0, 0, header_text.ljust(width - 1)[: width - 1], width - 1, styles["header"]
    )
    caret_x = 0
    if width > 1 and height > 1:
        caret_x = draw_search_bar(stdscr, 1, width, query, styles, search_active)

    loc_col_width = compute_location_col_width(rows)
    name_col_width = compute_name_col_width(rows, width, loc_col_width)
    if loc_col_width > 0:
        column_header = (
            f"{'NAME':<{name_col_width}}  "
            f"{LOC_COL_HEADER:<{loc_col_width}}  "
            f"{'AGE':>4}  TAGS"
        )
    else:
        column_header = f"{'NAME':<{name_col_width}}  {'AGE':>4}  TAGS"
    if height > 2 and width > 1:
        stdscr.addnstr(
            2, 0, column_header.ljust(width - 1)[: width - 1],
            width - 1, styles["column_header"],
        )

    list_top = 3
    footer_y = height - 1
    visible_lines = max(1, footer_y - list_top)

    if not rows:
        if list_top + 1 < footer_y:
            if query:
                empty_text = "(no matches)"
            elif view_mode == "live":
                empty_text = "(quiet — no unread, no active sessions)"
            else:
                empty_text = "(no messages)"
            stdscr.addnstr(list_top + 1, 2, empty_text, width - 3, styles["empty"])
    else:
        for screen_index in range(visible_lines):
            row_index = scroll_offset + screen_index
            if row_index >= len(rows):
                break
            line_y = list_top + screen_index
            if line_y >= footer_y:
                break
            row = rows[row_index]
            if row["type"] == "entry":
                segments = format_entry_segments(row["data"], name_col_width, loc_col_width)
                key_overrides = None
                if row_index == cursor:
                    row_override = styles["selected"]
                    key_overrides = {"entry_age": styles["selected_age"]}
                    for palette_index in range(TAG_PALETTE_SIZE):
                        key_overrides[f"entry_tag_{palette_index}"] = (
                            styles[f"selected_tag_{palette_index}"]
                        )
                elif row["data"].get("read"):
                    row_override = styles["read"]
                else:
                    row_override = None
                draw_segments(
                    stdscr, line_y, width, segments, styles,
                    override=row_override, key_overrides=key_overrides,
                )
            else:
                if row["type"] == "separator":
                    text = row["text"]
                    attribute = styles["divider"]
                else:
                    text = "  " + row["text"]
                    attribute = styles["empty"]
                stdscr.addnstr(
                    line_y, 0, text.ljust(width - 1)[: width - 1], width - 1, attribute
                )

    if footer_y > 1 and width > 1:
        clock_text = datetime.now().strftime("%H:%M:%S")
        clock_x = max(0, width - 1 - len(clock_text))
        if error_text:
            max_err = max(0, clock_x - 1)
            if max_err > 0:
                stdscr.addnstr(
                    footer_y, 0, error_text[:max_err], max_err, styles["error"]
                )
        stdscr.addnstr(footer_y, clock_x, clock_text, len(clock_text), styles["clock"])

    if height > 1 and width > 1 and search_active:
        stdscr.move(1, min(caret_x, width - 1))

    try:
        curses.curs_set(1 if search_active else 0)
    except curses.error:
        pass

    stdscr.refresh()


TAG_PAIR_BASE = 8
SELECTION_BG = 236


def init_styles():
    use_xterm_cube = curses.COLORS >= 256
    selection_bg = SELECTION_BG if use_xterm_cube else curses.COLOR_BLUE
    try:
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, -1)
        curses.init_pair(2, curses.COLOR_BLUE, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_WHITE, selection_bg)
        curses.init_pair(5, curses.COLOR_YELLOW, -1)
        curses.init_pair(6, curses.COLOR_WHITE, -1)
        curses.init_pair(7, curses.COLOR_YELLOW, selection_bg)

        if use_xterm_cube:
            tag_fg_colors = list(TAG_PALETTE_XTERM)
        else:
            ansi_fallback = (
                curses.COLOR_RED,
                curses.COLOR_GREEN,
                curses.COLOR_MAGENTA,
                curses.COLOR_CYAN,
            )
            tag_fg_colors = [
                ansi_fallback[i % len(ansi_fallback)]
                for i in range(TAG_PALETTE_SIZE)
            ]

        for palette_index, fg in enumerate(tag_fg_colors):
            curses.init_pair(TAG_PAIR_BASE + palette_index, fg, -1)
            curses.init_pair(
                TAG_PAIR_BASE + TAG_PALETTE_SIZE + palette_index,
                fg,
                selection_bg,
            )

        styles = {
            "header": curses.color_pair(1) | curses.A_BOLD,
            "divider": curses.color_pair(2) | curses.A_DIM,
            "column_header": curses.color_pair(6),
            "entry": curses.A_NORMAL,
            "entry_age": curses.color_pair(5),
            "entry_session": curses.color_pair(6),
            "entry_suffix": curses.color_pair(6),
            "selected": curses.color_pair(4),
            "selected_age": curses.color_pair(7),
            "search_prompt": curses.color_pair(6),
            "search_query": curses.color_pair(6) | curses.A_BOLD,
            "read": curses.A_DIM,
            "empty": curses.A_DIM,
            "clock": curses.A_DIM,
            "error": curses.color_pair(3) | curses.A_BOLD,
        }
        for palette_index in range(TAG_PALETTE_SIZE):
            styles[f"entry_tag_{palette_index}"] = curses.color_pair(
                TAG_PAIR_BASE + palette_index
            )
            styles[f"selected_tag_{palette_index}"] = curses.color_pair(
                TAG_PAIR_BASE + TAG_PALETTE_SIZE + palette_index
            )
        return styles
    except curses.error:
        styles = {
            "header": curses.A_BOLD,
            "divider": curses.A_DIM,
            "column_header": curses.A_NORMAL,
            "entry": curses.A_NORMAL,
            "entry_age": curses.A_NORMAL,
            "entry_session": curses.A_DIM,
            "entry_suffix": curses.A_DIM,
            "selected": curses.A_REVERSE | curses.A_BOLD,
            "selected_age": curses.A_REVERSE | curses.A_BOLD,
            "search_prompt": curses.A_NORMAL,
            "search_query": curses.A_BOLD,
            "read": curses.A_DIM,
            "empty": curses.A_DIM,
            "clock": curses.A_DIM,
            "error": curses.A_BOLD | curses.A_REVERSE,
        }
        for palette_index in range(TAG_PALETTE_SIZE):
            styles[f"entry_tag_{palette_index}"] = curses.A_NORMAL
            styles[f"selected_tag_{palette_index}"] = curses.A_REVERSE | curses.A_BOLD
        return styles


def tui(stdscr):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    try:
        curses.set_escdelay(25)
    except (AttributeError, curses.error):
        pass
    stdscr.timeout(1000)
    styles = init_styles()

    view_members = current_view_members()
    inbox_entries, running_entries = apply_view_scope(
        load_entries(), load_running(), view_members
    )
    view_mode = "live"
    query = ""
    search_active = False
    all_rows = build_rows(inbox_entries, running_entries, view_mode)
    rows = filter_rows(all_rows, query)
    cursor = first_selectable_index(rows)
    scroll_offset = 0
    last_inbox_sig = inbox_signature()
    last_running_sig = running_signature()
    error_text = ""
    error_until = 0.0

    while True:
        new_inbox_sig = inbox_signature()
        new_running_sig = running_signature()
        if new_inbox_sig != last_inbox_sig or new_running_sig != last_running_sig:
            saved_identity = (
                row_identity(rows[cursor]) if 0 <= cursor < len(rows) else None
            )
            saved_cursor = cursor
            inbox_entries, running_entries = apply_view_scope(
                load_entries(), load_running(), view_members
            )
            all_rows = build_rows(inbox_entries, running_entries, view_mode)
            rows = filter_rows(all_rows, query)
            cursor = reselect_by_identity(rows, saved_identity, saved_cursor)
            last_inbox_sig = new_inbox_sig
            last_running_sig = running_signature()

        height, _ = stdscr.getmaxyx()
        visible_lines = max(1, height - 3)
        if cursor >= 0:
            if cursor < scroll_offset:
                scroll_offset = cursor
            elif cursor >= scroll_offset + visible_lines:
                scroll_offset = cursor - visible_lines + 1

        total_unread = sum(1 for entry in inbox_entries if not entry.get("read"))
        active_count = len(running_entries)
        if error_text and datetime.now().timestamp() > error_until:
            error_text = ""
        render(
            stdscr,
            rows,
            cursor,
            scroll_offset,
            styles,
            view_mode,
            total_unread,
            active_count,
            query,
            error_text,
            search_active,
        )

        key = stdscr.getch()
        if key == -1:
            continue

        if search_active:
            # Search mode: typing edits the query, ESC cancels, Enter commits.
            if key == 27:
                search_active = False
                if query:
                    query = ""
                    rows = filter_rows(all_rows, query)
                    cursor = first_selectable_index(rows)
                    scroll_offset = 0
            elif key in (curses.KEY_ENTER, 10, 13):
                search_active = False
                if cursor >= 0 and rows[cursor]["type"] == "entry":
                    err = jump_to_session(rows[cursor]["data"].get("tmux_session", ""))
                    if err:
                        error_text = err
                        error_until = datetime.now().timestamp() + 3.0
                    else:
                        return
            elif key == curses.KEY_UP and cursor >= 0:
                cursor = find_next_selectable(rows, cursor, -1)
            elif key == curses.KEY_DOWN and cursor >= 0:
                cursor = find_next_selectable(rows, cursor, 1)
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                if query:
                    saved_identity = (
                        row_identity(rows[cursor]) if 0 <= cursor < len(rows) else None
                    )
                    query = query[:-1]
                    rows = filter_rows(all_rows, query)
                    cursor = reselect_by_identity(rows, saved_identity)
                    scroll_offset = 0
            elif key == 21:
                if query:
                    query = ""
                    rows = filter_rows(all_rows, query)
                    cursor = first_selectable_index(rows)
                    scroll_offset = 0
            elif 32 <= key <= 126:
                saved_identity = (
                    row_identity(rows[cursor]) if 0 <= cursor < len(rows) else None
                )
                query += chr(key)
                rows = filter_rows(all_rows, query)
                cursor = reselect_by_identity(rows, saved_identity)
                scroll_offset = 0
            continue

        # Command mode.
        if key == 27:
            return
        if key == curses.KEY_UP and cursor >= 0:
            cursor = find_next_selectable(rows, cursor, -1)
        elif key == curses.KEY_DOWN and cursor >= 0:
            cursor = find_next_selectable(rows, cursor, 1)
        elif key in (curses.KEY_ENTER, 10, 13) and cursor >= 0:
            row = rows[cursor]
            if row["type"] == "entry":
                err = jump_to_session(row["data"].get("tmux_session", ""))
                if err:
                    error_text = err
                    error_until = datetime.now().timestamp() + 3.0
                else:
                    return
        elif key == ord("/"):
            search_active = True
        elif key in (1, ord("a"), ord(" ")):
            if cursor >= 0:
                row = rows[cursor]
                if row["type"] == "entry" and row.get("kind") == "inbox":
                    mark_read(row["data"]["id"])
                    last_inbox_sig = -1.0
        elif key == 9:
            view_mode = VIEW_CYCLE[(VIEW_CYCLE.index(view_mode) + 1) % len(VIEW_CYCLE)]
            all_rows = build_rows(inbox_entries, running_entries, view_mode)
            rows = filter_rows(all_rows, query)
            cursor = first_selectable_index(rows)
            scroll_offset = 0


def main():
    arguments = sys.argv[1:]
    command = arguments[0] if arguments else "list"
    if command == "list":
        try:
            curses.wrapper(tui)
        except KeyboardInterrupt:
            pass
    elif command == "ack":
        mark_all_read()
    else:
        print("Usage: mx [list|ack]", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
