TAG_PALETTE_SIZE = 12

TAG_PALETTE_XTERM = (
    210,  # red       #f7768e
    167,  # red1      #db4b4b
    215,  # orange    #ff9e64
    149,  # green     #9ece6a
    80,   # green1    #73daca
    73,   # green2    #41a6b5
    37,   # teal      #1abc9c
    117,  # cyan      #7dcfff
