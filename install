#!/usr/bin/env bash
# tx-ide installer. Click-through, idempotent, safe to re-run.
# All file modifications back up to <file>.bak.<timestamp> before writing.
set -u

REPO="$(cd "$(dirname "$0")" && pwd)"
HOME_DIR="${HOME%/}"
STAMP=$(date +%Y%m%d%H%M%S)

PREFIX_FLAG=""
SKIP_ITERM=0
SKIP_SHELL_RC=0
SKIP_BREW=0
while (( $# > 0 )); do
  case "$1" in
    --prefix)        PREFIX_FLAG="$2"; shift 2 ;;
    --prefix=*)      PREFIX_FLAG="${1#*=}"; shift ;;
    --skip-iterm)    SKIP_ITERM=1; shift ;;
    --skip-shell-rc) SKIP_SHELL_RC=1; shift ;;
    --skip-brew)     SKIP_BREW=1; shift ;;
    -h|--help)
      cat <<'USAGE'
Usage: install [--prefix DIR] [--skip-iterm] [--skip-shell-rc] [--skip-brew]

  --prefix DIR      Install to DIR as a self-contained instance instead of
                    the primary layout (~/.tx-ide + ~/.claude + ~/.local/bin).
                    Activate with: source DIR/env
  --skip-iterm      Skip iTerm keymap + color preset configuration.
  --skip-shell-rc   Skip adding the PATH block to ~/.zshrc / ~/.bash_profile.
                    Implied when --prefix is set.
  --skip-brew       Skip the brew dependency block (tmux, fzf).
USAGE
      exit 0
      ;;
    *)
      printf 'install: unknown flag: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if [[ -n "$PREFIX_FLAG" ]]; then
  TX_PREFIX="$PREFIX_FLAG"
  LOCAL_BIN="$TX_PREFIX/bin"
  CLAUDE_DIR="$TX_PREFIX/claude"
  PER_INSTANCE=1
else
  TX_PREFIX="${TX_PREFIX:-$HOME_DIR/.tx-ide}"
  LOCAL_BIN="$HOME_DIR/.local/bin"
  CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME_DIR/.claude}"
  PER_INSTANCE=0
fi
TX_IDE_DIR="$TX_PREFIX"

B=$'\e[1m'
G=$'\e[32m'
Y=$'\e[33m'
RED=$'\e[31m'
D=$'\e[2m'
X=$'\e[0m'
ok() { printf '  %s→%s %-48s %s%s%s\n' "$G" "$X" "$1" "$G" "${2:-ok}" "$X"; }
warn() { printf '  %s→%s %-48s %s%s%s\n' "$Y" "$X" "$1" "$Y" "$2" "$X"; }
fail() { printf '  %s→%s %-48s %s%s%s\n' "$RED" "$X" "$1" "$RED" "$2" "$X"; }
info() { printf '  %s%s%s\n' "$D" "$*" "$X"; }
header() { printf '\n%s%s%s\n' "$B" "$*" "$X"; }

confirm() {
  local prompt="$1" default="${2:-N}" reply
  if [[ "$default" == Y ]]; then
    read -r -p "$prompt [Y/n] " reply || reply=""
    [[ -z "$reply" || "$reply" =~ ^[Yy]$ ]]
  else
    read -r -p "$prompt [y/N] " reply || reply=""
    [[ "$reply" =~ ^[Yy]$ ]]
  fi
}

# Symlink src → dst; idempotent; refuses to clobber non-symlinks.
link() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    local current
    current=$(readlink "$dst")
    if [[ "$current" == "$src" ]]; then
      ok "$dst" "already linked"
      return 0
    fi
    rm -f "$dst"
  elif [[ -e "$dst" ]]; then
    fail "$dst" "exists (not a symlink) — refusing to clobber"
    return 1
  fi
  ln -s "$src" "$dst"
  ok "$dst" "linked"
}

# Symlink for a directory target (uses -n to prevent symlink-into-symlink).
link_dir() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    local current
    current=$(readlink "$dst")
    if [[ "$current" == "$src" ]]; then
      ok "$dst" "already linked"
      return 0
    fi
    rm "$dst"
  elif [[ -e "$dst" ]]; then
    fail "$dst" "exists (not a symlink) — refusing to clobber"
    return 1
  fi
  ln -sn "$src" "$dst"
  ok "$dst" "linked"
}

# === Pre-flight ===

if (( PER_INSTANCE )); then
  cat <<EOF
${B}=== tx-ide install (per-instance) ===${X}

Repo:    $REPO
Prefix:  $TX_PREFIX

Self-contained instance install. Writes only under $TX_PREFIX.
Activate with: source $TX_PREFIX/env

EOF
else
  cat <<EOF
${B}=== tx-ide install ===${X}

Repo:  $REPO

I will:
  - check dependencies and brew-install tmux + fzf if missing
      (also warn if python3 / claude / gh are not on PATH)
  - symlink CLIs into ~/.local/bin/
      tx, tx-assistant, tmux-pane-for-session, tmux-pane-session-name
  - add ~/.local/bin to your shell PATH (zsh/bash; marker-tracked)
  - symlink Claude mailbox hooks dir: ~/.claude/hooks/mailbox/ → repo
  - symlink statusline: ~/.claude/statusline.sh → repo
  - symlink agents dir: ~/.tx-ide/agents/ → repo (orchestration role files)
  - create ~/.tx-ide/user-agents/ (empty; drop overrides + .local.md here)
  - write ~/.tx-ide/tmux.conf (a one-line file I own)
  - add one source-file block to ~/.tmux.conf (with markers + backup)
  - add hooks + statusLine to ~/.claude/settings.json (with backup)
      (4 mailbox hook entries + statusLine, tracked via a _tx_ide_managed
       marker so uninstall removes only ours. Your existing hooks,
       permissions, plugins, theme are untouched.)
  - configure iTerm: keyboard map + import tokyonight-night color preset,
      with a [Y/n] confirm to also apply it to your Default profile
      (only if iTerm is installed and currently quit)
  - start the mx-speaker background daemon

I will NOT touch:
  - any settings.json entry I didn't add (permissions, theme, plugins, other hooks)
  - ~/.claude/CLAUDE.md
  - any tmux config outside the marked source-file block
  - any iTerm preference if iTerm is currently running (you'll get a hint)
  - ~/.tx-ide/user-agents/ contents (your overrides survive re-runs)

After install:
  - run $(tx) from any tmux pane to pick a session
  - run $(tx start) to create the Views home-base and warm the tx-assistant
  - run $(tx mailbox) (or prefix+m) to open the inbox

EOF
fi

confirm "Proceed?" Y || {
  echo "Aborted."
  exit 0
}

# === 0: Dependencies ===
# Hard requirements (auto-installed via brew): tmux, fzf.
# Soft requirements (warn only): python3, claude, gh.
header "Dependencies"

if (( ! SKIP_BREW )); then
  if ! command -v brew >/dev/null 2>&1; then
    fail "homebrew" "not installed — install from https://brew.sh, then re-run"
    exit 1
  fi

  for pkg in tmux fzf; do
    if command -v "$pkg" >/dev/null 2>&1; then
      ok "$pkg" "already installed"
    else
      info "installing $pkg via brew..."
      if brew install "$pkg" 2>&1 | sed 's/^/    /'; then
        ok "$pkg" "installed"
      else
        fail "$pkg" "brew install failed"
        exit 1
      fi
    fi
  done
else
  info "skipping brew block (--skip-brew)"
fi

# Soft checks — warn but do not block.
if command -v python3 >/dev/null 2>&1; then
  ok "python3" "found"
else
  warn "python3" "missing — mailbox + hooks need it; install: brew install python"
fi
if command -v claude >/dev/null 2>&1; then
  ok "claude" "found"
else
  warn "claude" "missing — \`tx start\` needs Claude Code; see https://docs.claude.com/claude-code"
fi
if command -v gh >/dev/null 2>&1; then
  ok "gh" "found"
else
  warn "gh" "missing — coding workers need it to open draft PRs; install: brew install gh"
fi

# === 1: CLIs ===
header "CLIs into ~/.local/bin"
mkdir -p "$LOCAL_BIN"
link "$REPO/bin/tx" "$LOCAL_BIN/tx"
link "$REPO/bin/tx-assistant" "$LOCAL_BIN/tx-assistant"
link "$REPO/bin/tmux-pane-for-session" "$LOCAL_BIN/tmux-pane-for-session"
link "$REPO/bin/tmux-pane-session-name" "$LOCAL_BIN/tmux-pane-session-name"

# === 1b: ~/.local/bin on PATH ===
# Add a marked block to the user's shell rc so `tx` is callable from a fresh
# shell. Idempotent: detected via begin/end markers. Skipped if the rc already
# references the dir some other way (we don't want to duplicate the user's setup).
if (( ! SKIP_SHELL_RC && ! PER_INSTANCE )); then
  header "PATH"
  PATH_BEGIN="# === BEGIN tx-ide PATH ==="
  PATH_END="# === END tx-ide PATH ==="
  case ":${PATH:-}:" in
  *":$LOCAL_BIN:"*) ok "$LOCAL_BIN" "already on PATH in this session" ;;
  *) info "$LOCAL_BIN is not on \$PATH in this shell (new shells will pick it up)" ;;
  esac
  case "${SHELL:-}" in
  */zsh) rc_file="$HOME_DIR/.zshrc" ;;
  */bash) rc_file="$HOME_DIR/.bash_profile" ;;
  *) rc_file="" ;;
  esac
  if [[ -z "$rc_file" ]]; then
    warn "shell rc" "SHELL='${SHELL:-unknown}' — add $LOCAL_BIN to PATH yourself"
  elif [[ -f "$rc_file" ]] && grep -qF "$PATH_BEGIN" "$rc_file"; then
    ok "$rc_file" "tx-ide PATH block already present"
  elif grep -qsF "$LOCAL_BIN" "$rc_file" 2>/dev/null; then
    ok "$rc_file" "already references $LOCAL_BIN (left as-is)"
  else
    if [[ -f "$rc_file" ]]; then
      cp "$rc_file" "$rc_file.bak.$STAMP"
    else
      : >"$rc_file"
    fi
    cat >>"$rc_file" <<HEREDOC

$PATH_BEGIN
case ":\$PATH:" in *":\$HOME/.local/bin:"*) ;; *) export PATH="\$HOME/.local/bin:\$PATH" ;; esac
$PATH_END
HEREDOC
    ok "$rc_file" "PATH block added (open a new shell, or: source $rc_file)"
  fi
fi

# === 2: Claude hooks dir ===
header "Claude mailbox hooks"
mkdir -p "$CLAUDE_DIR/hooks"
link_dir "$REPO/claude/hooks" "$CLAUDE_DIR/hooks/mailbox"

# === 3: Statusline ===
header "Statusline"
link "$REPO/claude/statusline.sh" "$CLAUDE_DIR/statusline.sh"

# === 4: Agents (shipped + user override dir) ===
header "Agents"
mkdir -p "$TX_IDE_DIR"
link_dir "$REPO/agents" "$TX_IDE_DIR/agents"
if [[ -d "$TX_IDE_DIR/user-agents" ]]; then
  ok "$TX_IDE_DIR/user-agents" "already present"
else
  mkdir -p "$TX_IDE_DIR/user-agents"
  ok "$TX_IDE_DIR/user-agents" "created (empty)"
fi

# === 5: ~/.tx-ide/tmux.conf shim ===
header "Tmux config shim"
mkdir -p "$TX_IDE_DIR"
TX_IDE_CONF="$TX_IDE_DIR/tmux.conf"
desired_content="# Written by tx-ide install.sh — do not edit, re-run install to update.
# Repo: $REPO
run-shell '$REPO/tmux/tx-ide.tmux'
"
if [[ -f "$TX_IDE_CONF" ]] && [[ "$(cat "$TX_IDE_CONF")" == "$desired_content" ]]; then
  ok "$TX_IDE_CONF" "already current"
else
  if [[ -f "$TX_IDE_CONF" ]]; then
    cp "$TX_IDE_CONF" "$TX_IDE_CONF.bak.$STAMP"
  fi
  printf '%s' "$desired_content" >"$TX_IDE_CONF"
  ok "$TX_IDE_CONF" "written"
fi

# === 6: ~/.tmux.conf source-file block ===
# Per-instance install never edits ~/.tmux.conf; the instance's tmux server
# loads $TX_PREFIX/tmux.conf via TX_TMUX="tmux -f …".
if (( ! PER_INSTANCE )); then
  header "~/.tmux.conf source-file"
  USER_TMUX_CONF="$HOME_DIR/.tmux.conf"
  BEGIN_MARKER="# === BEGIN tx-ide ==="
  END_MARKER="# === END tx-ide ==="

  if [[ -f "$USER_TMUX_CONF" ]] && grep -qF "$BEGIN_MARKER" "$USER_TMUX_CONF"; then
    ok "$USER_TMUX_CONF" "block present"
  else
    if [[ -f "$USER_TMUX_CONF" ]]; then
      cp "$USER_TMUX_CONF" "$USER_TMUX_CONF.bak.$STAMP"
      note="backup: $USER_TMUX_CONF.bak.$STAMP"
    else
      : >"$USER_TMUX_CONF"
      note="file created"
    fi
    cat >>"$USER_TMUX_CONF" <<EOF

$BEGIN_MARKER
source-file $TX_IDE_CONF
$END_MARKER
EOF
    ok "$USER_TMUX_CONF" "block added"
    info "$note"
  fi
fi

# === 7: ~/.claude/settings.json merge ===
# We write hooks + statusLine directly into ~/.claude/settings.json (not
# settings.local.json — Claude Code doesn't read settings.local.json at user
# scope, only at project scope). A top-level `_tx_ide_managed` key tracks
# exactly what we added so uninstall removes only those entries and doctor
# detects drift. Claude Code ignores unknown top-level keys.
header "Claude settings.json"
SETTINGS_MAIN="$CLAUDE_DIR/settings.json"
SETTINGS_MAIN="$SETTINGS_MAIN" STAMP="$STAMP" CLAUDE_DIR="$CLAUDE_DIR" python3 - <<'PY'
import json, os, sys

main_path = os.environ["SETTINGS_MAIN"]
stamp = os.environ["STAMP"]
claude_dir = os.environ["CLAUDE_DIR"]

POST = f"{claude_dir}/hooks/mailbox/post.sh"
PRE  = f"{claude_dir}/hooks/mailbox/pre.sh"
END  = f"{claude_dir}/hooks/mailbox/end.sh"
STATUS = f"bash {claude_dir}/statusline.sh"

# Single source of truth for what tx-ide manages.
managed_hook_commands = {
    "Stop":              POST,
    "PermissionRequest": POST,
    "UserPromptSubmit":  PRE,
    "SessionEnd":        END,
}

def make_entry(cmd):
    return {"type": "command", "command": cmd, "timeout": 10, "async": True}

# Load (or initialize) settings.json.
if os.path.exists(main_path):
    real_path = os.path.realpath(main_path)
    with open(real_path) as fh:
        data = json.load(fh)
    backup_path = f"{real_path}.bak.{stamp}"
    with open(backup_path, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
else:
    real_path = main_path
    data = {}
    backup_path = None

# Append a hook entry for each event if our command isn't already wired.
def event_has_command(hooks_for_event, command):
    return any(
        h.get("command") == command
        for block in hooks_for_event
        for h in block.get("hooks", [])
    )

hooks = data.setdefault("hooks", {})
appended = []
already_present = []
for event, command in managed_hook_commands.items():
    bucket = hooks.setdefault(event, [])
    if event_has_command(bucket, command):
        already_present.append(event)
    else:
        bucket.append({"matcher": "", "hooks": [make_entry(command)]})
        appended.append(event)

# statusLine: add ours if absent. If present and matches ours, leave it
# (idempotent). If present and different, leave the user's untouched and
# print a warning — they have their own; we don't shadow.
status_msg = ""
status_existing = data.get("statusLine", {}).get("command")
if status_existing is None:
    data["statusLine"] = {"type": "command", "command": STATUS}
    status_msg = "added"
elif status_existing == STATUS:
    status_msg = "already current"
else:
    status_msg = f"skipped — user has their own ({status_existing!r}). Move it aside if you want tx-ide's."

# Write the marker. Always overwrite — declares current intent.
data["_tx_ide_managed"] = {
    "version": 1,
    "hook_commands": managed_hook_commands,
    "statusLine_command": STATUS if data.get("statusLine", {}).get("command") == STATUS else None,
}

with open(real_path, "w") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")

state = "merged" if appended or status_msg == "added" else "already current"
print(f"  \033[32m→\033[0m {main_path}    \033[32m{state}\033[0m")
if backup_path:
    print(f"  \033[2mbackup: {backup_path}\033[0m")
if appended:
    print(f"  \033[2mhooks added: {', '.join(appended)}\033[0m")
if already_present:
    print(f"  \033[2mhooks already present: {', '.join(already_present)}\033[0m")
print(f"  \033[2mstatusLine: {status_msg}\033[0m")
print(f"  \033[2m_tx_ide_managed marker written (uninstall + doctor use this)\033[0m")
PY

# === 8: iTerm (keymap + tokyonight-night colors) ===
if (( ! SKIP_ITERM )); then
  header "iTerm setup"
  if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
    if pgrep -x iTerm2 >/dev/null 2>&1; then
      warn "iTerm" "iTerm is running — quit it, then run $REPO/setup/iterm.sh --apply-colors"
    else
      iterm_flag=""
      if confirm "Apply tokyonight-night to your Default iTerm profile?" Y; then
        iterm_flag="--apply-colors"
      else
        info "Skipping color apply. The preset is still imported — pick it from"
        info "iTerm Settings → Profiles → Colors → Color Presets when you want it."
      fi
      if "$REPO/setup/iterm.sh" $iterm_flag 2>&1 | sed 's/^/  /'; then
        ok "iTerm" "keymap + preset configured"
      else
        fail "iTerm" "setup script failed; see $REPO/setup/iterm.sh output"
      fi
    fi
  else
    warn "iTerm" "TERM_PROGRAM='${TERM_PROGRAM:-unknown}' — skipping (iTerm only)"
  fi
fi

# === 9: mailbox config ===
# The mx-speaker daemon (and any future mailbox-side feature) reads this file
# on every event and assumes it exists with all expected keys, so install must
# seed it. Re-runs preserve user edits.
write_default_mailbox_config() {
  cat >"$1" <<'JSON'
{
  "tts": {
    "enabled": true
  }
}
JSON
}

header "Mailbox config"
config_file="$CLAUDE_DIR/mailbox/config.json"
if [[ -e "$config_file" ]]; then
  ok "$config_file" "exists (preserved)"
else
  mkdir -p "$(dirname "$config_file")"
  write_default_mailbox_config "$config_file"
  ok "$config_file" "seeded"
fi

# === 10: mx-speaker daemon ===
# Per-instance install does not launch the daemon — start-speaker.sh still
# targets ~/.claude until Slice 3 teaches it CLAUDE_CONFIG_DIR. The instance's
# speaker is launched by `tx start` once the env is active.
if (( ! PER_INSTANCE )); then
  header "mx-speaker daemon"
  "$REPO/claude/hooks/start-speaker.sh" 2>&1 | sed 's/^/  → /'
fi

# === 11: reload tmux (only if a server is already running) ===
# Per-instance install never sources ~/.tmux.conf; the instance's tmux server
# picks up $TX_PREFIX/tmux.conf via TX_TMUX on first launch.
if (( ! PER_INSTANCE )); then
  header "Reload tmux"
  if tmux info >/dev/null 2>&1; then
    if tmux source-file "$HOME_DIR/.tmux.conf" 2>&1 | sed 's/^/  → /'; then
      ok "tmux bindings" "reloaded"
    fi
  else
    info "no tmux server running — bindings will load when you next start tmux"
  fi
fi

# === 12: per-instance env file (per-instance only) ===
if (( PER_INSTANCE )); then
  header "Instance env file"
  mkdir -p "$TX_PREFIX/tmux" "$TX_PREFIX/state"
  env_file="$TX_PREFIX/env"
  cat >"$env_file" <<EOF
# tx-ide instance env — source this to activate
export TX_PREFIX="$TX_PREFIX"
export CLAUDE_CONFIG_DIR="$CLAUDE_DIR"
export TMUX_TMPDIR="$TX_PREFIX/tmux"
export TX_TMUX="tmux -f $TX_PREFIX/tmux.conf"
export PATH="$TX_PREFIX/bin:\$PATH"
EOF
  ok "$env_file" "written"
fi

# === Final ===
if (( PER_INSTANCE )); then
  cat <<EOF

${B}=== Done ===${X}

${B}Activate this instance:${X}
  ${D}source $TX_PREFIX/env && tx start${X}

${B}Tear down:${X}
  ${D}rm -rf $TX_PREFIX${X}  (Slice 3 adds \`tx teardown\` for clean kill)

EOF
else
  cat <<EOF

${B}=== Done ===${X}

${B}Set up the tx-ide view:${X}
  ${D}tx start${X}  (creates the Views home-base and warms the tx-assistant)

${B}Customize roles (optional):${X}
  ${D}drop overrides in ~/.tx-ide/user-agents/ (e.g. TX-ASSISTANT.local.md)${X}

${B}Undo:${X}
  ${D}$REPO/uninstall${X}

EOF
fi

# If the current shell doesn't have ~/.local/bin on PATH, re-exec it so `tx`
# is immediately callable. Skipped when PATH is already correct (most common
# on re-runs) so we don't surprise the user with a "fresh shell" needlessly.
# Per-instance install never re-execs the shell — activation is explicit via
# `source $TX_PREFIX/env`.
if (( ! PER_INSTANCE )); then
  case ":${PATH:-}:" in
  *":$LOCAL_BIN:"*) : ;;
  *)
    if [[ -n "${SHELL:-}" && -x "$SHELL" ]]; then
      printf '%sReloading shell so `tx` is on PATH... (exit to return to your previous shell)%s\n' "$D" "$X"
      exec "$SHELL" -l
    fi
    ;;
  esac
fi
